rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active(role) { return signedIn() && profile().role == role && profile().status == 'active'; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function teaches(courseId) {
      return active('teacher') && exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }
    function enrolled(courseId) {
      return active('student') && exists(/databases/$(database)/documents/enrollments/$(courseId + '--' + request.auth.uid))
        && get(/databases/$(database)/documents/enrollments/$(courseId + '--' + request.auth.uid)).data.status == 'active';
    }
    function enrolledInSection(courseId, sectionId) {
      return enrolled(courseId) && (sectionId == null
        || get(/databases/$(database)/documents/enrollments/$(courseId + '--' + request.auth.uid)).data.sectionId == sectionId);
    }
    function teacherWrite() { return active('teacher') && request.resource.data.teacherId == request.auth.uid; }
    function validSection(data) {
      return data.sectionId == null || (exists(/databases/$(database)/documents/sections/$(data.sectionId))
        && get(/databases/$(database)/documents/sections/$(data.sectionId)).data.courseId == data.courseId
        && get(/databases/$(database)/documents/sections/$(data.sectionId)).data.teacherId == request.auth.uid);
    }
    function validEnrollment(data) {
      let path = /databases/$(database)/documents/enrollments/$(data.courseId + '--' + data.studentId);
      return exists(path) && get(path).data.status == 'active'
        && get(path).data.courseId == data.courseId && get(path).data.studentId == data.studentId
        && get(path).data.teacherId == request.auth.uid
        && (data.sectionId == null || data.sectionId == get(path).data.sectionId);
    }
    function validGrade(data) {
      let assessment = /databases/$(database)/documents/assessments/$(data.assessmentId);
      return data.enrollmentId == data.courseId + '--' + data.studentId && validEnrollment(data)
        && exists(assessment) && get(assessment).data.courseId == data.courseId
        && get(assessment).data.teacherId == request.auth.uid
        && (get(assessment).data.sectionId == null || get(assessment).data.sectionId == data.sectionId)
        && data.score is number && data.maxScore is number && data.maxScore > 0
        && data.score >= 0 && data.score <= data.maxScore;
    }
    function teacherUpdate() { return active('teacher') && resource.data.teacherId == request.auth.uid
      && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.courseId == resource.data.courseId
      && teaches(resource.data.courseId) && validSection(request.resource.data); }
    match /users/{uid} {
      allow get: if owner(uid) || active('admin');
      allow list: if active('admin');
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['uid','name','email','role','status','photoURL','createdAt','updatedAt'])
        && request.resource.data.uid == uid && request.resource.data.role == 'student'
        && request.resource.data.status == 'active' && request.resource.data.email == request.auth.token.email;
      // Los cambios administrativos pasan por API validada y auditoría.
      allow update, delete: if false;
      match /courseProgress/{id} { allow read, write: if owner(uid) && active('student'); }
      match /lessonNotes/{id} { allow read, write: if owner(uid) && active('student'); }
      match /playgroundSessions/{id} {
        allow read: if owner(uid) && active('student');
        // Las prácticas nuevas se contabilizan exclusivamente desde el servidor.
        allow write: if owner(uid) && active('student') && !id.matches('.*--real$');
      }
      match /examProgress/{id} { allow read: if owner(uid) && active('student'); }
      match /examAttempts/{id} {
        allow read: if owner(uid) && active('student');
        allow update: if owner(uid) && active('student') && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers','flaggedQuestionIds','currentQuestionIndex','remainingSeconds','updatedAt'])
          && request.time <= resource.data.startedAt + duration.value(resource.data.durationSeconds, 's')
          && request.resource.data.answers is map && request.resource.data.answers.size() <= 100
          && request.resource.data.flaggedQuestionIds is list && request.resource.data.flaggedQuestionIds.size() <= 100
          && request.resource.data.currentQuestionIndex is int && request.resource.data.currentQuestionIndex >= 0
          && request.resource.data.remainingSeconds is int && request.resource.data.remainingSeconds >= 0
          && request.resource.data.remainingSeconds <= resource.data.durationSeconds;
      }
      match /aiUsage/{id} { allow read: if owner(uid); }
    }
    match /courses/{id} {
      allow read: if (active('teacher') && resource.data.teacherId == request.auth.uid) || enrolled(id) || active('admin');
      allow create: if teacherWrite();
      allow update: if active('teacher') && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
    }
    match /sections/{id} {
      allow read: if (active('teacher') && resource.data.teacherId == request.auth.uid) || enrolled(resource.data.courseId) || active('admin');
      allow create: if teacherWrite() && getAfter(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId == request.auth.uid;
      allow update: if active('teacher') && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.courseId == resource.data.courseId && teaches(resource.data.courseId);
    }
    match /enrollments/{id} {
      allow read: if (active('teacher') && resource.data.teacherId == request.auth.uid) || (owner(resource.data.studentId) && active('student')) || active('admin');
    }
    match /lessonPlans/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid)
        || (enrolledInSection(resource.data.courseId, resource.data.sectionId) && resource.data.visibleToStudents == true);
      allow create: if teacherWrite() && teaches(request.resource.data.courseId) && validSection(request.resource.data);
      allow update: if teacherUpdate();
      allow delete: if active('teacher') && resource.data.teacherId == request.auth.uid;
    }
    match /assessments/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid)
        || (enrolledInSection(resource.data.courseId, resource.data.sectionId) && resource.data.visibleToStudents == true);
      allow create: if teacherWrite() && teaches(request.resource.data.courseId) && validSection(request.resource.data);
      allow update: if teacherUpdate();
      allow delete: if active('teacher') && resource.data.teacherId == request.auth.uid;
    }
    match /grades/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid)
        || (owner(resource.data.studentId) && active('student') && resource.data.status == 'published');
      allow create: if teacherWrite() && teaches(request.resource.data.courseId)
        && validGrade(request.resource.data);
      allow update: if teacherUpdate() && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.assessmentId == resource.data.assessmentId && validGrade(request.resource.data);
    }
    match /materials/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid)
        || (enrolledInSection(resource.data.courseId, resource.data.sectionId) && resource.data.visibleToStudents == true);
      allow create: if teacherWrite() && teaches(request.resource.data.courseId) && validSection(request.resource.data);
      allow update: if teacherUpdate();
      allow delete: if active('teacher') && resource.data.teacherId == request.auth.uid;
    }
    match /onlineClasses/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid)
        || (enrolledInSection(resource.data.courseId, resource.data.sectionId) && resource.data.visibleToStudents == true);
      allow create: if teacherWrite() && teaches(request.resource.data.courseId) && validSection(request.resource.data);
      allow update: if teacherUpdate();
      allow delete: if active('teacher') && resource.data.teacherId == request.auth.uid;
    }
    match /attendance/{id} {
      allow read: if active('admin') || (active('teacher') && resource.data.teacherId == request.auth.uid) || (owner(resource.data.studentId) && active('student'));
      allow create: if teacherWrite() && teaches(request.resource.data.courseId)
        && validSection(request.resource.data) && validEnrollment(request.resource.data);
      allow update: if teacherUpdate() && request.resource.data.studentId == resource.data.studentId && validEnrollment(request.resource.data);
    }
    match /aiLogs/{id} { allow read: if active('admin'); }
    match /adminAudit/{id} { allow read: if active('admin'); }
    match /systemSettings/{id} {
      allow read: if id == 'general' && (active('admin') || active('teacher') || active('student'));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
