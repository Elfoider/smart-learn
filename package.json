{
  "name": "smart-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "local-ai": "node --env-file=local-ai/.env local-ai/server.mjs",
    "test:ai": "node --test tests/local-ai.test.mjs tests/ai-provider.test.mjs",
    "test:practice": "node --test tests/practice.test.mjs tests/demo-content.test.mjs",
    "demo:preview": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo:load": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs --apply",
    "test:integration": "node --experimental-test-module-mocks --test tests/api-workflows.test.mjs tests/sprint7-core.test.mjs",
    "test": "npm run test:practice && npm run test:ai && npm run test:integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.14.0",
    "@hookform/resolvers": "^5.5.7",
    "@opentelemetry/api": "^1.9.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.9.9 <13"
  }
}
